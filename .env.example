# The app runs from the checked-in snapshot unless MySQL is explicitly enabled.
DATA_SOURCE=snapshot
# All MySQL features use this connection, including admin imports and short links.
DB_HOST=flybubble-do-user-8008698-0.k.db.ondigitalocean.com
DB_PORT=25060
DB_NAME=defaultdb
DB_USER=doadmin
DB_PASSWORD=
# DigitalOcean App Platform can bind this directly to ${your-db.CA_CERT}.
DB_CA_CERT=
# Optional local alternative: path to a downloaded trusted CA certificate.
DB_CA_PATH=
SITE_ORIGIN=http://localhost:3000

# Short links use gear_share_links in the same database, even in snapshot mode.
# Run yarn db:share-links once with a user allowed to CREATE this table.
# Runtime sharing needs SELECT and INSERT on gear_share_links only.

# /admin accepts a short test password in development. Use a random password
# of at least 16 characters in production. A value in .env.local overrides .env.
ADMIN_IMPORT_PASSWORD=
# Catalogue imports require DATA_SOURCE=mysql and write permissions for DB_USER.
# DigitalOcean model access key (the same variable used by Flybubble Ask).
# Enable the Web Search feature preview. Never use NEXT_PUBLIC_ for these settings.
DO_AI_KEY=
DO_INFERENCE_MODEL=deepseek-v4.1-flash-1017
