# The app runs from the checked-in snapshot unless MySQL is explicitly enabled.
DATA_SOURCE=snapshot
DB_HOST=flybubble-do-user-8008698-0.k.db.ondigitalocean.com
DB_PORT=25060
DB_NAME=defaultdb
DB_USER=doadmin
DB_PASSWORD=
# DigitalOcean App Platform can bind this directly to ${your-db.CA_CERT}.
DB_CA_CERT=
# Optional local alternative: path to a downloaded trusted CA certificate.
DB_CA_PATH=
SITE_ORIGIN=http://localhost:3000

# Short links use gear_share_links in the same database, even in snapshot mode.
# Run yarn db:share-links once with a user allowed to CREATE this table.
# Runtime sharing needs SELECT and INSERT on gear_share_links only.
# Optional separate credentials (otherwise the DB_* settings above are used).
SHARE_DB_HOST=
SHARE_DB_PORT=
SHARE_DB_NAME=
SHARE_DB_USER=
SHARE_DB_PASSWORD=
SHARE_DB_CA_CERT=
